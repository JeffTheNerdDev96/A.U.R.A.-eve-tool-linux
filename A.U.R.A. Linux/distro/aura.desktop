[Desktop Entry]
Version=1.0
Type=Application
Name=Adaptive Underworld Recon Array
GenericName=EVE Online Tactical Companion
Comment=Angel Cartel EVE Online Tactical AI Assistant & Intel Radar
Exec={{APP_ROOT}}/distro/run_aura.sh
Icon={{APP_ROOT}}/assets/brand/app_icon.png
Terminal=false
Categories=Game;Utility;
Keywords=eve;online;intel;tactical;radar;dscan;fitting;
StartupNotify=true
StartupWMClass=AURA
Actions=DebugMode;

[Desktop Action DebugMode]
Name=Launch in Debug Terminal
Exec=bash -c "{{APP_ROOT}}/distro/run_aura.sh; read -p 'Press enter to exit...'"
Terminal=true
